# Copy to .env and fill in. Never commit .env (the repo is public).

# Meta Model API (https://dev.meta.ai/docs/authentication)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Reasoning tiers (see docs/knowledge-base/02-architecture.md, decision D-33)
REASONING_ROUTINE_PROVIDER=meta
REASONING_ROUTINE_MODEL=muse-spark-1.3
REASONING_DEEP_MODEL=muse-wonder-1.0

# Optional later: Muse Spark Open on Baseten (open-weight bonus, paid by card)
# REASONING_ROUTINE_PROVIDER=baseten
# REASONING_ROUTINE_MODEL=meta-models/muse-spark-open-1026
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SEGMENT_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# Spend guard (USD per experiment run; worker stops model calls above this)
RUN_SPEND_CAP_USD=10

# Alerts (ntfy topic acts as a password: use a long random string)
NTFY_TOPIC=

# Smart plug (only one of these is needed)
SHELLY_HOST=
KASA_HOST=
KASA_USERNAME=
KASA_PASSWORD=
