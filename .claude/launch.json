{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "worker",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "worker",
        "run",
        "--env-file",
        "../.env",
        "uvicorn",
        "--factory",
        "argus.api.app:app_from_env",
        "--timeout-graceful-shutdown",
        "1",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
